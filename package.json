{
  "name": "supabase-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx --bun vite build",
    "check": "oxlint && oxfmt --check",
    "db:migrate:down": "supabase migration down --local",
    "db:migrate:gen": "supabase db schema declarative sync --no-apply --yes",
    "db:migrate:up": "supabase migration up --local",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:typegen": "supabase gen types typescript --local > src/lib/db/types.ts && bun fmt",
    "dev": "bunx --bun vite",
    "env:up": "bun install && bun db:start && bun env:upsert-vars",
    "env:upsert-vars": "bun scripts/env-upsert-vars.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "bunx --bun vite preview",
    "wt": "bun scripts/worktree.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vite": "^8.3.4"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3"
}
